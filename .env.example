# Banco de dados (PostgreSQL). Combina com o docker-compose.yml.
DATABASE_URL="postgresql://gastos:gastos@localhost:5432/controle_gastos?schema=public"

# Autenticação single-user.
# APP_PASSWORD: a senha para entrar no app.
# AUTH_SECRET: segredo para assinar o cookie de sessão (JWT).
APP_PASSWORD="troque-esta-senha"
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
